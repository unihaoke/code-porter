# CodePorter 部署环境变量（复制为 .env 后按需修改）

# 网页控制台对外端口
WEB_PORT=80

# 容器时区
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 以下变量不会自动注入容器，仅作为「需要改哪些配置」的清单。
# 真正生效需要同步修改 backend/configs/gateway.yaml 中的对应字段：
#
#   server.public_addr    网关对外地址，机器人回调 URL 由它拼出，必须是公网可达的 https 地址
#                         例：https://cp.example.com
#   security.admin_token  网页控制台登录令牌（务必修改）
#   security.api_keys     外部 OpenAI 客户端使用的 Key（务必修改）
#   agent.token           本地 Agent 的鉴权令牌，需与 configs/agent.yaml 一致（务必修改）
# ---------------------------------------------------------------------------

GATEWAY_PUBLIC_ADDR=https://cp.example.com
ADMIN_TOKEN=change-me-admin-token
API_KEY=sk-codeporter-demo-key
AGENT_ID=local-pc
AGENT_TOKEN=change-me-agent-token
