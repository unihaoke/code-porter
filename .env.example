# CodePorter 部署环境变量（复制为 .env 后按需修改）
# 覆盖优先级：进程环境变量 > .env > configs/*.yaml
# 仅上面两行的变量会被 docker compose 读取；带 # 注释的行不生效。

# ---------- Web 控制台对外端口 ----------
WEB_PORT=80
TZ=Asia/Shanghai

# ---------- MySQL 8（compose 自动创建容器与库） ----------
MYSQL_DATABASE=codeporter
MYSQL_USER=codeporter
# 【务必修改】数据库业务账号密码；尽量只使用字母数字，避免 URL 编码问题
MYSQL_PASSWORD=tiger
# 【务必修改】MySQL root 密码
MYSQL_ROOT_PASSWORD=tiger

# ---------- 网关 ----------
# 网页控制台/机器人回调的对外可访问地址（机器人必须用公网可达的 https 地址）
# 本地试用可保持 http://127.0.0.1:9022
GATEWAY_PUBLIC_ADDR=http://127.0.0.1:9022

# 网页登录会话有效期（默认 7 天）
AUTH_SESSION_TTL=168h

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 默认 AI 工具（未指定模型时使用）
BOT_DEFAULT_MODEL=claude-code

# ---------- 首次登录 ----------
# 迁移会自动创建管理员：用户名 admin，默认密码 admin123
# 首次登录后请立即在「个人菜单 → 修改密码」中修改，启动日志也会持续告警。

# ---------- 本地 Agent（另一台机器/本机客户端，不在 compose 内） ----------
# 在控制台创建含 agent 权限的秘钥后，客户端用该秘钥连接：
#   AGENT_KEY=cp_xxxx
#   AGENT_GATEWAY_ADDR=http://<网关地址>:9022
